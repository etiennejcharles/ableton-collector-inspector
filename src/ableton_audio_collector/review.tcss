Screen {
    background: #111111;
    color: #E7E7E7;
}

#topbar,
#collection-topbar {
    height: 3;
    padding: 0 2;
    background: #171717;
    border-bottom: solid #313131;
    content-align: left middle;
}

#brand,
.collection-brand {
    width: 24;
    color: #F2F2F2;
    text-style: bold;
    content-align: left middle;
}

#brand {
    border-left: solid #FF746C;
    padding-left: 1;
}

#folder-path {
    width: 1fr;
    color: #858585;
    content-align: left middle;
}

#scan-state,
#collection-state {
    width: auto;
    min-width: 18;
    content-align: right middle;
}

#summary {
    height: 6;
    padding: 1 2 0 2;
    background: #111111;
}

.metric-card {
    width: 1fr;
    height: 5;
    margin-right: 1;
    padding: 0 2;
    background: #191919;
    border: solid #303030;
    content-align: left middle;
}

.total-card {
    border-left: solid #777777;
}

.ready-card {
    border-left: solid #75D9A6;
}

.safe-card {
    border-left: solid #7FB5FF;
}

.issue-card {
    margin-right: 0;
    border-left: solid #F3BE63;
}

#workspace {
    height: 1fr;
    margin: 1 2;
}

#set-list-panel {
    width: 64%;
    height: 1fr;
    margin-right: 1;
    background: #171717;
    border: solid #303030;
}

#inspector-panel {
    width: 36%;
    height: 1fr;
    background: #171717;
    border: solid #303030;
}

#filter-bar {
    height: 4;
    padding: 0 1;
    background: #191919;
    border-bottom: solid #303030;
    content-align: left middle;
}

.eyebrow {
    color: #777777;
    text-style: bold;
}

#sets-heading {
    width: 1fr;
    padding-left: 1;
    content-align: left middle;
}

.filter-button {
    width: auto;
    min-width: 8;
    height: 3;
    margin: 0;
    padding: 0 1;
    background: transparent;
    color: #777777;
    border: none;
    text-style: none;
}

.filter-button:hover {
    background: #242424;
    color: #C7C7C7;
}

.filter-button.active {
    background: #292929;
    color: #FF746C;
    text-style: bold;
}

#sets {
    height: 1fr;
    background: #151515;
    color: #B7B7B7;
    border: none;
}

#sets > .datatable--header {
    background: #202020;
    color: #858585;
    text-style: bold;
}

#sets > .datatable--cursor {
    background: #2B2B2B;
    color: #F2F2F2;
}

#sets > .datatable--odd-row {
    background: #181818;
}

#list-state {
    height: 1fr;
    align: center middle;
    content-align: center middle;
}

#scan-spinner {
    width: 8;
    height: 3;
    color: #FF746C;
}

#list-state-copy {
    width: 80%;
    height: auto;
    margin: 1 0;
    color: #858585;
    text-align: center;
}

#retry-scan {
    width: auto;
    min-width: 16;
}

#inspector-heading {
    height: 4;
    padding: 1 2;
    background: #191919;
    border-bottom: solid #303030;
    content-align: left middle;
}

#inspector-scroll {
    height: 1fr;
    scrollbar-color: #4A4A4A;
    scrollbar-color-hover: #FF746C;
    scrollbar-background: #171717;
}

#details {
    width: 100%;
    height: auto;
    padding: 2;
}

#action-bar {
    height: 4;
    padding: 0 2;
    background: #181818;
    border-top: solid #303030;
    content-align: left middle;
}

#selection-summary {
    width: 1fr;
    padding-left: 1;
    color: #858585;
    content-align: left middle;
}

#clear-selection {
    width: auto;
    min-width: 10;
    height: 3;
    margin-right: 1;
    background: transparent;
    color: #A7A7A7;
    border: none;
}

#collect-button,
#collection-done {
    width: auto;
    min-width: 20;
    height: 3;
    background: #FF746C;
    color: #111111;
    border: none;
    text-style: bold;
}

#collect-button:hover,
#collection-done:hover {
    background: #FF8B84;
}

#collect-button:disabled,
#collection-done:disabled {
    background: #303030;
    color: #686868;
}

Footer {
    height: 1;
    background: #101010;
    color: #777777;
}

Footer > .footer--key {
    background: #242424;
    color: #E7E7E7;
}

Footer > .footer--description {
    background: #101010;
    color: #777777;
}

ConfirmScreen {
    align: center middle;
    background: #000000 70%;
}

#confirm-dialog {
    width: 76;
    height: auto;
    max-height: 30;
    padding: 2 3;
    background: #1B1B1B;
    border: tall #FF746C;
}

#confirm-title {
    height: auto;
    margin-top: 1;
    color: #F2F2F2;
    text-style: bold;
}

#confirm-summary-scroll {
    height: 9;
    max-height: 14;
    margin-top: 1;
    scrollbar-color: #4A4A4A;
    scrollbar-color-hover: #FF746C;
    scrollbar-background: #1B1B1B;
}

#confirm-summary {
    width: 100%;
    height: auto;
    padding: 1 0;
}

#confirm-note {
    height: auto;
    margin-top: 1;
    color: #858585;
}

#confirm-buttons {
    height: 4;
    margin-top: 1;
    align-horizontal: right;
}

#confirm-buttons Button {
    width: auto;
    min-width: 15;
    height: 3;
    margin-left: 1;
}

#confirm-buttons #apply {
    background: #FF746C;
    color: #111111;
    border: none;
    text-style: bold;
}

CollectionScreen {
    background: #111111;
}

#collection-state {
    color: #F3BE63;
}

#collection-panel {
    width: 100;
    height: 1fr;
    margin: 2 4;
    padding: 2 3;
    background: #171717;
    border: solid #303030;
}

#collection-title {
    height: 2;
    margin-top: 1;
    color: #F2F2F2;
    text-style: bold;
}

#collection-current {
    height: 2;
    color: #858585;
}

#collection-progress {
    height: 3;
    margin-bottom: 1;
    color: #FF746C;
}

#collection-outcome-scroll {
    height: 1fr;
    margin-top: 1;
    padding: 1 2;
    background: #141414;
    border: solid #292929;
}

#outcome-cards {
    width: 100%;
    height: auto;
}

.outcome-card {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    padding: 1 2;
    background: #181818;
    border: solid #303030;
}

.outcome-success {
    border-left: solid #75D9A6;
}

.outcome-failure {
    border-left: solid #FF6B63;
}

#collection-actions {
    height: 4;
    margin-top: 1;
    content-align: left middle;
}

#collection-note {
    width: 1fr;
    color: #777777;
    content-align: left middle;
}
